# Store text files with LF in the repo, check them out native to the OS.
# Keeps diffs clean if this is ever opened on Mac or Linux.
* text=auto

# The admin writes these with LF; keep them LF everywhere so saving
# in the admin never shows up as a whole-file change.
src/data/*.json text eol=lf

# Binary assets — never line-ending-converted.
*.webp binary
*.gif  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.avif binary
*.ico  binary
